<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <AssemblyName>Jellyfin.Plugin.TorBoxSync</AssemblyName>
    <RootNamespace>Jellyfin.Plugin.TorBoxSync</RootNamespace>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <Version>0.1.0.0</Version>
    <AssemblyVersion>0.1.0.0</AssemblyVersion>
    <FileVersion>0.1.0.0</FileVersion>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <CopyLocalLockFileAssemblies>false</CopyLocalLockFileAssemblies>
  </PropertyGroup>

  <ItemGroup>
    <Compile Remove="tests/**/*.cs" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="MediaBrowser.Common" HintPath="/usr/lib/jellyfin/bin/MediaBrowser.Common.dll" Private="false" />
    <Reference Include="MediaBrowser.Controller" HintPath="/usr/lib/jellyfin/bin/MediaBrowser.Controller.dll" Private="false" />
    <Reference Include="MediaBrowser.Model" HintPath="/usr/lib/jellyfin/bin/MediaBrowser.Model.dll" Private="false" />
    <Reference Include="Jellyfin.Api" HintPath="/usr/lib/jellyfin/bin/Jellyfin.Api.dll" Private="false" />
    <Reference Include="Jellyfin.Data" HintPath="/usr/lib/jellyfin/bin/Jellyfin.Data.dll" Private="false" />
    <Reference Include="Microsoft.AspNetCore.Authorization" HintPath="/usr/lib/jellyfin/bin/Microsoft.AspNetCore.Authorization.dll" Private="false" />
    <Reference Include="Microsoft.AspNetCore.Http.Abstractions" HintPath="/usr/lib/jellyfin/bin/Microsoft.AspNetCore.Http.Abstractions.dll" Private="false" />
    <Reference Include="Microsoft.AspNetCore.Mvc.Abstractions" HintPath="/usr/lib/jellyfin/bin/Microsoft.AspNetCore.Mvc.Abstractions.dll" Private="false" />
    <Reference Include="Microsoft.AspNetCore.Mvc.Core" HintPath="/usr/lib/jellyfin/bin/Microsoft.AspNetCore.Mvc.Core.dll" Private="false" />
    <Reference Include="Microsoft.Extensions.DependencyInjection.Abstractions" HintPath="/usr/lib/jellyfin/bin/Microsoft.Extensions.DependencyInjection.Abstractions.dll" Private="false" />
    <Reference Include="Microsoft.Extensions.Hosting.Abstractions" HintPath="/usr/lib/jellyfin/bin/Microsoft.Extensions.Hosting.Abstractions.dll" Private="false" />
    <Reference Include="Microsoft.Extensions.Http" HintPath="/usr/lib/jellyfin/bin/Microsoft.Extensions.Http.dll" Private="false" />
    <Reference Include="Microsoft.Extensions.Logging.Abstractions" HintPath="/usr/lib/jellyfin/bin/Microsoft.Extensions.Logging.Abstractions.dll" Private="false" />
  </ItemGroup>
</Project>
